# Copy this file to .env and paste your real API key.
# Never commit .env or share your key publicly.

# Answers and question translation (Anthropic Claude).
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5

# Speech-to-text runs locally with Whisper, so no speech API key is needed.
# tiny is the smallest/fastest model; small or medium are more accurate but slower.
WHISPER_MODEL=tiny
